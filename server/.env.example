# Copy to .env and fill in real values. Never commit the real .env file.

PORT=5000
MONGO_URI=mongodb://localhost:27017/foodsaver-ai
JWT_SECRET=replace-with-a-long-random-string

# Base URL of the React app (Vite dev server default shown). Used to build
# the password-reset link sent by email — must NOT have a trailing slash.
CLIENT_URL=http://localhost:5173

# Gmail account FoodSaver AI sends notification/contact emails from.
# EMAIL_PASS must be a Gmail App Password, not your normal account password.
EMAIL_USER=hello.foodsaverai@gmail.com
EMAIL_PASS=replace-with-a-gmail-app-password

# The one authorized FoodSaver AI Admin address. Used for the login error
# message and by `npm run seed:admin` — does not by itself grant access.
ADMIN_EMAIL=hello.foodsaverai@gmail.com

# Only used when running `npm run seed:admin` to create the admin account
# for the first time. Not read anywhere else — safe to leave unset day-to-day.
# ADMIN_SEED_PASSWORD=
# ADMIN_NAME=FoodSaver AI Admin

# Google Gemini API key, used ONLY server-side by server/services/aiVisionService.js
# for real food-image analysis (POST /api/ai/analyze). Get one at
# https://aistudio.google.com/apikey — never expose this to the client/Vite build.
# If unset, /api/ai/analyze returns a 503 rather than fabricating a result.
GEMINI_API_KEY=replace-with-a-real-gemini-api-key
